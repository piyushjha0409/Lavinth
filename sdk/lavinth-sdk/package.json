{
  "name": "@lavinth/sdk",
  "version": "1.0.0",
  "description": "Lavinth SDK for Solana wallet security - compromise detection, fund tracking, and recovery",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solana",
    "wallet",
    "security",
    "blockchain",
    "crypto",
    "recovery",
    "lavinth"
  ],
  "author": "Lavinth",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@solana/web3.js": "^1.87.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.70.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lavinth/sdk"
  }
}
