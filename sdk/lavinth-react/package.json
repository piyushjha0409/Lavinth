{
  "name": "@lavinth/react",
  "version": "1.0.0",
  "description": "React components and hooks for Lavinth wallet security",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solana",
    "wallet",
    "security",
    "react",
    "hooks",
    "lavinth"
  ],
  "author": "Lavinth",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@lavinth/sdk": "file:../lavinth-sdk"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@solana/web3.js": "^1.70.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
